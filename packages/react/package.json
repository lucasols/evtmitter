{
  "name": "@evtmitter/react",
  "description": "React hooks for evtmitter",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup --minify --dts",
    "build:no-test": "tsup --minify --dts",
    "lint": "tsc && eslint src/ tests/",
    "tsc": "tsc --noEmit",
    "test": "cd ../evtmitter && pnpm build:no-test && cd ../react && vitest run",
    "format": "prettier --write src tests",
    "pre-publish": "../../scripts/check-if-is-sync.sh && pnpm build",
    "npm-publish": "pnpm pre-publish && pnpm publish --access public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14.6.0"
  },
  "repository": "github:lucasols/evtmitter",
  "author": "Lucas Santos",
  "dependencies": {
    "evtmitter": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "happy-dom": "^15.11.6",
    "vitest": "^2.1.6"
  }
}
