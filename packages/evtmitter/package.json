{
  "name": "evtmitter",
  "description": "A tiny event emitter for typescript",
  "version": "1.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm tsc && pnpm lint && pnpm test && pnpm build:no-test",
    "build:no-test": "tsup --minify --dts",
    "lint": "tsc && eslint src/ tests/",
    "tsc": "tsc --noEmit",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "pre-publish": "../scripts/check-if-is-sync.sh && pnpm build"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14.6.0"
  },
  "repository": "github:lucasols/evtmitter",
  "author": "Lucas Santos"
}
